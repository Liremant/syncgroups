  "authors": [],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.craftsync.syncgroups.SyncGroupsMod"
    ]
  },
  "mixins": [
    "syncgroups.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
